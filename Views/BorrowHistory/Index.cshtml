@model LibraryApp.ViewModels.BorrowHistory.BorrowHistoryViewModel
@using LibraryApp.ViewModels.Shared

@{
    ViewData["Title"] = "Lịch sử mượn";

    var routes = new Dictionary<string, string?>
    {
        ["status"] = Model.Filter.Status
    };

    var pagination = new PaginationViewModel
    {
        CurrentPage = Model.BorrowRecords.PageIndex,
        TotalPages = Model.BorrowRecords.TotalPages,
        Action = "Index",
        RouteValues = routes
    };
}
<div class="d-flex justify-content-between align-items-center mb-4 py-4">

    <div>

        <h2 class="fw-bold mb-1">

            Lịch sử mượn sách

        </h2>

        <p class="text-muted mb-0">

            Theo dõi các phiếu mượn của bạn.

        </p>

    </div>

</div>
<div class="card shadow-sm border-0 rounded-4 mb-4">

    <div class="card-body">

        <ul class="nav nav-pills">

            <li class="nav-item">

                <a asp-route-status="all"
                   class="nav-link @(Model.Filter.Status=="all"?"active":"")">

                    Tất cả

                </a>

            </li>

            <li class="nav-item">

                <a asp-route-status="borrowing"
                   class="nav-link @(Model.Filter.Status=="borrowing"?"active":"")">

                    Đang mượn

                </a>

            </li>

            <li class="nav-item">

                <a asp-route-status="returned"
                   class="nav-link @(Model.Filter.Status=="returned"?"active":"")">

                    Đã trả

                </a>

            </li>

            <li class="nav-item">

                <a asp-route-status="overdue"
                   class="nav-link @(Model.Filter.Status=="overdue"?"active":"")">

                    Quá hạn

                </a>

            </li>

        </ul>

    </div>

</div>
@foreach (var item in Model.BorrowRecords)
{
    <div class="card shadow-sm border-0 rounded-4 mb-3">

        <div class="card-body">

            <div class="row align-items-center">

                <div class="col-lg-8">

                    <h5 class="fw-bold">

                        Phiếu mượn #PM@(item.BorrowRecordId.ToString("D5"))

                    </h5>

                    <div class="text-muted">

                        <div>

                            <i class="bi bi-calendar-event"></i>

                            Ngày mượn:

                            @item.BorrowDate.ToString("dd/MM/yyyy")

                        </div>

                        <div>

                            <i class="bi bi-clock-history"></i>

                            Hạn trả:

                            @item.DueDate.ToString("dd/MM/yyyy")

                        </div>

                        <div>

                            <i class="bi bi-bookshelf"></i>

                            Số sách:

                            @item.TotalBooks quyển

                        </div>

                    </div>

                </div>

                <div class="col-lg-4 text-lg-end">

                    @switch(item.Status)
                    {
                        case "Đã trả":

                            <span class="badge bg-success px-3 py-2">

                                Đã trả

                            </span>

                            break;

                        case "Đang mượn":

                            <span class="badge bg-warning text-dark px-3 py-2">

                                Đang mượn

                            </span>

                            break;

                        default:

                            <span class="badge bg-danger px-3 py-2">

                                Quá hạn

                            </span>

                            break;
                    }

                    <div class="mt-3">

                        <a asp-action="Detail"
                           asp-route-id="@item.BorrowRecordId"
                           class="btn btn-primary rounded-pill">

                            <i class="bi bi-eye me-1"></i>

                            Xem chi tiết

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>
}
<partial name="_Pagination"
         model="pagination"/>