@model LibraryApp.ViewModels.Book.BookDetailViewModel
@using LibraryApp.ViewModels.Home
@using LibraryApp.Enums

@{
    ViewData["Title"] = Model.Title;

    var relatedBooks =
        ViewBag.RelatedBooks as List<BookCardViewModel>
        ?? new();
}

<div class="container py-4">

    <!-- Breadcrumb -->

    <nav class="mb-4">

        <a asp-controller="Home" asp-action="Index" class="text-decoration-none">

            Trang chủ

        </a>

        <span class="mx-2">/</span>

        <a asp-controller="Books" asp-action="Index" class="text-decoration-none">

            Danh sách sách

        </a>

        <span class="mx-2">/</span>

        <span class="text-muted">

            @Model.Title

        </span>

    </nav>

    <div class="row g-5">

        <!-- Cover -->

        <div class="col-lg-4">

            <div class="sticky-top" style="top:90px;">

                <div class="card border-0 shadow rounded-4">

                    <div class="card-body text-center">

                        @if (!string.IsNullOrWhiteSpace(Model.CoverImage))
                        {
                            <img src="@Model.CoverImage" class="img-fluid" style="max-height:500px;
                            object-fit:contain;" />
                        }
                        else
                        {
                            <img src="~/uploads/books/no-book.png" class="img-fluid" style="max-height:400px;
                            object-fit:contain;" />
                        }

                    </div>

                </div>

            </div>

        </div>

        <!-- Information -->

        <div class="col-lg-8">

            <h1 class="fw-bold mb-3">

                @Model.Title

            </h1>

            <div class="mb-4">

                @if (Model.IsAvailable)
                {
                    <span class="badge bg-success rounded-pill px-3 py-2">

                        Còn @Model.AvailableQuantity quyển

                    </span>
                }
                else
                {
                    <span class="badge bg-danger rounded-pill px-3 py-2">

                        Hết sách

                    </span>
                }

            </div>

            <div class="row g-3 mb-4">

                <div class="col-md-6">

                    <div class="card border-0 bg-light h-100">

                        <div class="card-body">

                            <small class="text-muted">

                                <i class="bi bi-person"></i>

                                Tác giả

                            </small>

                            <div class="fw-semibold fs-5">

                                @Model.AuthorNames

                            </div>

                        </div>

                    </div>

                </div>

                <div class="col-md-6">

                    <div class="card border-0 bg-light h-100">

                        <div class="card-body">

                            <small class="text-muted">

                                <i class="bi bi-bookmark"></i>

                                Thể loại

                            </small>

                            <div class="fw-semibold fs-5">

                                @Model.CategoryName

                            </div>

                        </div>

                    </div>

                </div>

                <div class="col-md-6">

                    <div class="card border-0 bg-light h-100">

                        <div class="card-body">

                            <small class="text-muted">

                                <i class="bi bi-building"></i>

                                Nhà xuất bản

                            </small>

                            <div class="fw-semibold">

                                @Model.Publisher

                            </div>

                        </div>

                    </div>

                </div>

                <div class="col-md-6">

                    <div class="card border-0 bg-light h-100">

                        <div class="card-body">

                            <small class="text-muted">

                                <i class="bi bi-calendar-event"></i>

                                Năm xuất bản

                            </small>

                            <div class="fw-semibold">

                                @Model.PublishYear

                            </div>

                        </div>

                    </div>

                </div>


                <div class="col-md-6">

                    <div class="card border-0 bg-light h-100">

                        <div class="card-body">

                            <small class="text-muted">

                                <i class="bi bi-collection"></i>

                                Tổng số lượng

                            </small>

                            <div class="fw-semibold">

                                @Model.Quantity quyển

                            </div>

                        </div>

                    </div>

                </div>

            </div>
            @if (User.IsInRole(AccountRole.Resident.ToString()))
            {
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <button id="favoriteDetailBtn"
                            class="btn @(Model.IsFavorite ? "btn-danger" : "btn-outline-danger") rounded-pill"
                            data-book-id="@Model.BookId" data-favorite="@Model.IsFavorite.ToString().ToLower()">

                        @if (Model.IsFavorite)
                        {
                            <i class="bi bi-heart-fill me-2"></i>

                            <span>Đã yêu thích</span>
                        }
                        else
                        {
                            <i class="bi bi-heart me-2"></i>

                            <span>Yêu thích</span>
                        }

                    </button>
                }
                else
                {
                    <a asp-controller="Login" asp-action="Index" class="btn btn-outline-primary btn-lg rounded-pill px-5">

                        <i class="bi bi-box-arrow-in-right me-2"></i>

                        Đăng nhập để thêm vào yêu thích

                    </a>
                }
            }
        </div>

    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Description))
    {
        <div class="card border-0 shadow-sm rounded-4 mt-5">

            <div class="card-body p-4">

                <h3 class="fw-bold mb-3">

                    Giới thiệu sách

                </h3>

                <p class="mb-0" style="white-space:pre-line;
                    line-height:1.9">

                    @Model.Description

                </p>

            </div>

        </div>
    }

    @if (relatedBooks.Any())
    {
        <div class="mt-5">

            <div class="d-flex
                justify-content-between
                align-items-center
                mb-4">

                <div>

                    <h3 class="fw-bold mb-1">

                        Có thể bạn cũng quan tâm

                    </h3>

                    <small class="text-muted">

                        Những đầu sách cùng chủ đề

                    </small>

                </div>

            </div>

            <div class="row
                row-cols-1
                row-cols-md-2
                row-cols-lg-4
                g-4">

                @foreach (var item in relatedBooks)
                {
                    <partial name="_BookCard" model="item" />
                }

            </div>

        </div>
    }

    <div class="mt-5">

        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill">

            <i class="bi bi-arrow-left me-2"></i>

            Quay lại danh sách

        </a>

    </div>

</div>

<script>

    document.addEventListener("DOMContentLoaded", () => {

        const btn =
            document.getElementById("favoriteDetailBtn");

        if (!btn)
            return;

        const token = document.querySelector(
            '#antiForgeryForm input[name="__RequestVerificationToken"]'
        ).value;

        btn.addEventListener("click", async () => {

            btn.disabled = true;

            try {

                const response =
                    await fetch("/Favorite/ToggleAjax", {

                        method: "POST",

                        headers: {
                            "Content-Type": "application/x-www-form-urlencoded",
                            "RequestVerificationToken": token
                        },

                        body: new URLSearchParams({
                            bookId: btn.dataset.bookId
                        })

                    });

                const result =
                    await response.json();

                if (!result.success)
                    return;

                btn.dataset.favorite = result.isFavorite;

                const icon =
                    btn.querySelector("i");

                const text =
                    btn.querySelector("span");

                if (result.isFavorite) {

                    btn.classList.remove("btn-outline-danger");

                    btn.classList.add("btn-danger");

                    icon.className = "bi bi-heart-fill me-2";

                    text.textContent = "Đã yêu thích";

                }
                else {

                    btn.classList.remove("btn-danger");

                    btn.classList.add("btn-outline-danger");

                    icon.className = "bi bi-heart me-2";

                    text.textContent = "Yêu thích";

                }

                icon.animate([
                    { transform: "scale(1)" },
                    { transform: "scale(1.3)" },
                    { transform: "scale(1)" }
                ], {
                    duration: 180
                });

                showFavoriteToast(result.message);

            }
            finally {

                btn.disabled = false;

            }

        });

    });

</script>