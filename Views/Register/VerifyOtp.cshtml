@model LibraryApp.ViewModels.VerifyOtpViewModel

@{
    ViewData["Title"] = "Xác thực Email";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-5">

            <div class="card shadow border-0 rounded-4">

                <div class="card-header bg-primary text-white text-center py-4">

                    <i class="bi bi-envelope-check-fill display-5"></i>

                    <h3 class="mt-3 mb-1">

                        Xác thực Email

                    </h3>

                    <p class="mb-0 opacity-75">

                        Nhập mã OTP đã được gửi đến email của bạn

                    </p>

                </div>

                <div class="card-body p-4">

                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger">

                            @TempData["Error"]

                        </div>
                    }

                    <form asp-action="VerifyOtp" method="post" id="otpForm">

                        @Html.AntiForgeryToken()

                        <input asp-for="Email" type="hidden" />

                        <div class="mb-4 text-center">

                            <label class="form-label fw-semibold">

                                Email xác thực

                            </label>

                            <div class="fw-bold text-primary">

                                @Model.Email

                            </div>

                        </div>

                        <!-- OTP -->

                        <div class="mb-4">

                            <label class="form-label fw-semibold d-block text-center">

                                Mã OTP

                            </label>

                            <div class="d-flex justify-content-center gap-2 mb-3">

                                @for (int i = 0; i < 6; i++)
                                {
                                    <input type="text" class="form-control otp-input text-center fw-bold fs-4" maxlength="1"
                                           inputmode="numeric" autocomplete="off" style="width:55px;height:60px;" />
                                }

                            </div>

                            <input asp-for="OtpCode" id="OtpCode" type="hidden" />

                            <span asp-validation-for="OtpCode" class="text-danger"></span>


                        </div>

                        <div class="text-center mb-4">

                            <small class="text-muted">

                                Bạn chưa nhận được mã?

                            </small>

                            <br />

                            <span id="countdown" class="fw-bold text-primary">

                                60

                            </span>

                            giây

                        </div>

                        <div class="d-grid gap-2">

                            <button id="btnVerify" type="submit" class="btn btn-primary btn-lg">

                                <i class="bi bi-check-circle-fill me-2"></i>

                                Xác nhận

                            </button>

                            <button id="btnResend" type="button" class="btn btn-outline-secondary" disabled>

                                <i class="bi bi-arrow-repeat me-2"></i>

                                Gửi lại OTP

                            </button>
                            <a asp-action="Index" class="btn btn-light">

                                Quay lại

                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>
        //=====================================
        // DOM Elements
        //=====================================

        const otpInputs =
            document.querySelectorAll(".otp-input");

        const hiddenOtp =
            document.getElementById("OtpCode");

        const btnVerify =
            document.getElementById("btnVerify");

        const btnResend =
            document.getElementById("btnResend");

        const countdown =
            document.getElementById("countdown");

        const email =
            document.querySelector('input[name="Email"]').value;

        const antiForgeryToken =
            document.querySelector(
                'input[name="__RequestVerificationToken"]'
            ).value;

        let timer = null;

        //=====================================
        // Initialize
        //=====================================

        init();

        function init() {

            initOtpInput();

            initResendButton();

            startCountdown();

        }

        //=====================================
        // Events
        //=====================================

        function initResendButton() {

            btnResend.addEventListener(
                "click",
                resendOtp);

        }

        //=====================================
        // OTP
        //=====================================

        function initOtpInput() {

            otpInputs[0].focus();

            otpInputs.forEach((input, index) => {

                input.addEventListener("input", () => {

                    input.value =
                        input.value.replace(/\D/g, "");

                    updateOtp();

                    if (input.value && index < otpInputs.length - 1) {
                        otpInputs[index + 1].focus();
                    }

                });

                input.addEventListener("keydown", e => {

                    if (
                        e.key === "Backspace"
                        && input.value === ""
                        && index > 0) {
                        otpInputs[index - 1].focus();
                    }

                    if (e.key === "Enter") {
                        btnVerify.click();
                    }

                });

            });

            otpInputs[0].addEventListener(
                "paste",
                pasteOtp);

        }
        function updateOtp() {

            hiddenOtp.value =
                [...otpInputs]
                    .map(x => x.value)
                    .join("");

        }
        function pasteOtp(e) {

            e.preventDefault();

            const text =
                e.clipboardData
                    .getData("text")
                    .trim();

            if (!/^\d{6}$/.test(text))
                return;

            [...text].forEach((number, index) => {

                otpInputs[index].value =
                    number;

            });

            updateOtp();

            otpInputs[5].focus();

        }
        //=====================================
        // Countdown
        //=====================================

        function startCountdown() {

            if (timer)
                clearInterval(timer);

            let seconds = 60;

            btnResend.disabled = true;

            btnResend.classList.remove(
                "btn-success");

            btnResend.classList.add(
                "btn-outline-secondary");

            countdown.innerHTML = "01:00";

            timer = setInterval(() => {

                seconds--;

                const minute =
                    String(Math.floor(seconds / 60))
                        .padStart(2, "0");

                const second =
                    String(seconds % 60)
                        .padStart(2, "0");

                countdown.innerHTML =
                    `${minute}:${second}`;

                if (seconds <= 0) {

                    clearInterval(timer);

                    countdown.innerHTML =
                        "Có thể gửi lại";

                    btnResend.disabled = false;

                    btnResend.classList.remove(
                        "btn-outline-secondary");

                    btnResend.classList.add(
                        "btn-success");

                }

            }, 1000);

        }
        //=====================================
        // Resend OTP
        //=====================================

        async function resendOtp() {

            btnResend.disabled = true;

            btnResend.innerHTML =
                `<span class="spinner-border spinner-border-sm me-2"></span>
             Đang gửi...`;

            try {

                const response =
                    await fetch("/Register/ResendOtp", {

                        method: "POST",

                        headers: {

                            "Content-Type": "application/json",

                            "RequestVerificationToken":
                                antiForgeryToken

                        },

                        body: JSON.stringify({

                            email: email

                        })

                    });

                if (!response.ok)
                    throw new Error();

                const result =
                    await response.json();

                if (result.success) {

                    await Swal.fire({

                        icon: "success",

                        title: "Đã gửi OTP",

                        text: result.message,

                        timer: 1800,

                        showConfirmButton: false

                    });

                    btnResend.innerHTML =
                        '<i class="bi bi-arrow-repeat me-2"></i> Gửi lại OTP';

                    startCountdown();

                }
                else {

                    throw new Error(result.message);

                }

            }
            catch (ex) {

                Swal.fire({

                    icon: "error",

                    title: "Lỗi",

                    text: ex.message || "Không thể gửi OTP."

                });

                btnResend.disabled = false;

                btnResend.innerHTML =
                    '<i class="bi bi-arrow-repeat me-2"></i> Gửi lại OTP';

            }

        }
    </script>

}

<style>
    .otp-input {

        border-radius: 12px;

        font-weight: bold;

        font-size: 24px;

        text-align: center;

        transition: .2s;

    }

    .otp-input:focus {

        transform: scale(1.08);

        box-shadow: 0 0 0 .25rem rgba(13, 110, 253, .25);

    }
</style>