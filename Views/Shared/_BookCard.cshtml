@model LibraryApp.ViewModels.Home.BookCardViewModel

<div class="col">

    <div class="card book-card h-100 shadow-sm border-0 rounded-4">

        <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height:280px;">

            @if (!string.IsNullOrWhiteSpace(Model.CoverImage))
            {
                <img src="@Model.CoverImage" class="img-fluid" style="max-height:260px;

                max-width:100%;

                object-fit:contain;" />
            }
            else
            {
                <img src="~/uploads/books/no-book.png" class="img-fluid" style="max-height:260px;

                object-fit:contain;" />
            }

            @if (Model.AvailableQuantity > 0)
            {
                <span class="badge bg-success 
                    position-absolute
                    top-0
                    end-0
                    m-2">

                    Còn @Model.AvailableQuantity

                </span>
            }
            else
            {
                <span class="badge bg-danger
                    position-absolute
                    top-0
                    end-0
                    m-2">

                    Hết sách

                </span>
            }

        </div>

        <div class="card-body d-flex flex-column">

            <h6 class="card-title fw-bold">

                @Model.Title

            </h6>

            <div class="small text-muted mb-1">

                <i class="bi bi-person"></i>

                @Model.AuthorName

            </div>

            <div class="small text-muted mb-3">

                <i class="bi bi-bookmark"></i>

                @Model.CategoryName

            </div>

            <div class="mt-auto">

                <a asp-controller="Books" asp-action="Detail" asp-route-id="@Model.BookId"
                   class="btn btn-primary  w-100 rounded-pill">

                    <i class="bi bi-book me-2"></i>

                    Xem chi tiết

                </a>

            </div>

        </div>

    </div>

</div>

<style>
    .book-card {
        height: 100%;
        transition: .25s;
    }

    .book-card:hover {

        transform: translateY(-6px);

        box-shadow: 0 .75rem 1.5rem rgba(0, 0, 0, .15);

    }
</style>