@model LibraryApp.ViewModels.Shared.PaginationViewModel

@if (Model.TotalPages > 1)
{
    var current = Model.CurrentPage;
    var total = Model.TotalPages;

    <nav class="mt-4">

        <ul class="pagination justify-content-center">

            <!-- First -->

            <li class="page-item @(current==1?"disabled":"")">

                <a class="page-link"
                   asp-action="@Model.Action"
                   asp-all-route-data="Model.RouteValues"
                   asp-route-page="1">

                    <i class="bi bi-chevron-double-left"></i>

                </a>

            </li>

            <!-- Previous -->

            <li class="page-item @(current==1?"disabled":"")">

                <a class="page-link"
                   asp-action="@Model.Action"
                   asp-all-route-data="Model.RouteValues"
                   asp-route-page="@(current-1)">

                    <i class="bi bi-chevron-left"></i>

                </a>

            </li>

            @{
                int start = Math.Max(1, current - 2);
                int end = Math.Min(total, current + 2);

                if (current <= 3)
                    end = Math.Min(total, 5);

                if (current >= total - 2)
                    start = Math.Max(1, total - 4);
            }

            @if (start > 1)
            {
                <li class="page-item">

                    <a class="page-link"
                       asp-action="@Model.Action"
                       asp-all-route-data="Model.RouteValues"
                       asp-route-page="1">

                        1

                    </a>

                </li>

                @if (start > 2)
                {
                    <li class="page-item disabled">

                        <span class="page-link">

                            ...

                        </span>

                    </li>
                }
            }

            @for (int i = start; i <= end; i++)
            {
                <li class="page-item @(i==current?"active":"")">

                    <a class="page-link"
                       asp-action="@Model.Action"
                       asp-all-route-data="Model.RouteValues"
                       asp-route-page="@i">

                        @i

                    </a>

                </li>
            }

            @if (end < total)
            {
                @if (end < total - 1)
                {
                    <li class="page-item disabled">

                        <span class="page-link">

                            ...

                        </span>

                    </li>
                }

                <li class="page-item">

                    <a class="page-link"
                       asp-action="@Model.Action"
                       asp-all-route-data="Model.RouteValues"
                       asp-route-page="@total">

                        @total

                    </a>

                </li>
            }

            <!-- Next -->

            <li class="page-item @(current==total?"disabled":"")">

                <a class="page-link"
                   asp-action="@Model.Action"
                   asp-all-route-data="Model.RouteValues"
                   asp-route-page="@(current+1)">

                    <i class="bi bi-chevron-right"></i>

                </a>

            </li>

            <!-- Last -->

            <li class="page-item @(current==total?"disabled":"")">

                <a class="page-link"
                   asp-action="@Model.Action"
                   asp-all-route-data="Model.RouteValues"
                   asp-route-page="@total">

                    <i class="bi bi-chevron-double-right"></i>

                </a>

            </li>

        </ul>

    </nav>
}