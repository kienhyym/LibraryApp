@using System.Security.Claims
@using LibraryApp.Enums

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LibraryApp</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/LibraryApp.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>

<body>

    @{
        var currentController =
            ViewContext.RouteData.Values["controller"]?.ToString();

        var currentAction =
            ViewContext.RouteData.Values["action"]?.ToString();

        var hideSearch =

            currentController == "Books"

            && currentAction == "Index";
    }
    <form id="antiForgeryForm" style="display:none;">

        @Html.AntiForgeryToken()

    </form>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm sticky-top">
            <div class="container">

                <a class="navbar-brand fw-bold text-primary ml-4" asp-controller="Home" asp-action="Index">

                    <img src="~/uploads/books/logo.png" class="img-fluid" style="max-height:70px;
                object-fit:contain" />

                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainMenu">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <div class="collapse navbar-collapse" id="mainMenu">

                    <ul class="navbar-nav me-auto">

                        <li class="nav-item">

                            <a asp-controller="Books" asp-action="Index"
                               class="nav-link fw-semibold @(currentController == "Books" ? "active" : "")">

                                <i class="bi bi-book"></i>

                                Sách

                            </a>

                        </li>

                        <li class="nav-item">

                            <a asp-controller="Categories" asp-action="Index"
                               class="nav-link fw-semibold @(currentController == "Categories" ? "active" : "")">

                                <i class="bi bi-tags"></i>

                                Thể loại

                            </a>

                        </li>

                        <li class="nav-item">

                            <a asp-controller="Authors" asp-action="Index"
                               class="nav-link fw-semibold @(currentController == "Authors" ? "active" : "")">

                                <i class="bi bi-person-badge"></i>

                                Tác giả

                            </a>

                        </li>
                        <li class="nav-item">

                            <a asp-controller="Home" asp-action="About" class="nav-link fw-semibold
                                @(currentController == "Home" && currentAction == "About"
                    ? "active"
                    : "")">

                                Giới thiệu

                            </a>

                        </li>

                    </ul>
                    @if (!hideSearch)

                    {
                        <form class="d-flex me-3" style="width:300px" asp-controller="Books" asp-action="Index"
                              method="get">

                            <input class="form-control me-2" type="search" name="Keyword"
                                   value="@Context.Request.Query["Keyword"]" placeholder="Tìm tên sách..." />

                            <button class="btn btn-primary" type="submit">

                                <i class="bi bi-search"></i>

                            </button>

                        </form>
                    }
                    @if (User.Identity!.IsAuthenticated)
                    {
                        <div class="dropdown">

                            <button class="btn btn-light dropdown-toggle" data-bs-toggle="dropdown">

                                <i class="bi bi-person-circle"></i>

                                @User.Identity.Name

                            </button>

                            <ul class="dropdown-menu dropdown-menu-end">
                                @if (User.IsInRole(AccountRole.Admin.ToString()) ||
                                                           User.IsInRole(AccountRole.Personnel.ToString()))
                                {
                                    <li class="nav-item">

                                        <a asp-area="Admin" asp-controller="Information" asp-action="Index" class="dropdown-item  fw-semibold
                                            @(currentController == "Information" ? "active" : "")">

                                            <i class="bi bi-person-circle me-1"></i>

                                            Hồ sơ

                                        </a>

                                    </li>

                                }
                                else
                                {
                                    <li class="nav-item">

                                        <a asp-controller="Profile" asp-action="Index" class="nav-link fw-semibold
                                            @(currentController == "Profile" ? "active" : "")">

                                            <i class="bi bi-person-circle me-1"></i>

                                            Hồ sơ

                                        </a>

                                    </li>

                                }
                                @if (User.IsInRole(AccountRole.Resident.ToString()))
                                {
                                <li class="nav-item">

                                    <a asp-controller="Favorite" asp-action="Index" class="nav-link fw-semibold
                                        @(currentController == "Favorite" ? "active" : "")">

                                        <i class="bi bi-heart-fill me-1 text-danger"></i>

                                        Yêu thích

                                    </a>

                                </li>
                                }
                                @if (User.IsInRole(AccountRole.Resident.ToString()))
                                {
                                    <li class="nav-item">

                                        <a asp-controller="BorrowHistory" asp-action="Index" class="nav-link fw-semibold
                                            @(currentController == "BorrowHistory"
                                  ? "active"
                                  : "")">

                                            <i class="bi bi-clock-history me-1"></i>

                                            Lịch sử mượn

                                        </a>

                                    </li>
                                }
                                <li>
                                    <hr class="dropdown-divider">
                                </li>

                                <li>

                                    <a asp-controller="Login" asp-action="Logout" class="dropdown-item text-danger">

                                        <i class="bi bi-box-arrow-right"></i>

                                        Đăng xuất

                                    </a>

                                </li>

                            </ul>

                        </div>
                    }
                    else
                    {
                        <a asp-controller="Login" asp-action="Index" class="btn btn-outline-primary me-2">

                            Đăng nhập

                        </a>

                        <a asp-controller="Register" asp-action="Index" class="btn btn-warning">

                            Đăng ký

                        </a>
                    }

                </div>

            </div>

        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="bg-dark text-white mt-5 py-4">

        <div class="container text-center">

            <h5>

                <i class="bi bi-book-half"></i>

                Library Management System

            </h5>

            <p>

                Hệ thống quản lý thư viện dành cho chung cư

            </p>

            <hr>

            <small>

                © 2026 LibraryApp - Graduation Project

            </small>

        </div>

    </footer>

    <div id="favoriteToast" class="toast
        position-fixed
        bottom-0
        end-0
        m-4
        border-0
        shadow" data-bs-delay="2000">

        <div class="toast-body bg-success text-white rounded">

        </div>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <script>

        document.addEventListener("click", async function (e) {

        const btn = e.target.closest(".favorite-btn");

        if (!btn) return;

        e.preventDefault();

        const bookId = btn.dataset.bookId;

        const token = document.querySelector(
        'input[name="__RequestVerificationToken"]'
        ).value;

        const response = await fetch("/Favorite/ToggleAjax", {

        method: "POST",

        headers: {

        "Content-Type": "application/x-www-form-urlencoded",

        "RequestVerificationToken": token

        },

        body:

        "bookId=" + bookId

        });

        const result = await response.json();

        const icon = btn.querySelector("i");

        if (result.isFavorite) {

        icon.className =

        "bi bi-heart-fill text-danger";

        }
        else {

        icon.className =

        "bi bi-heart";

        }

        const toastEl =
        document.getElementById("favoriteToast");

        toastEl.querySelector(".toast-body").innerText =
        result.message;

        new bootstrap.Toast(toastEl).show();

        });

    </script>
    <script>

        document.addEventListener("DOMContentLoaded", () => {

        const token = document.querySelector(
        '#antiForgeryForm input[name="__RequestVerificationToken"]'
        ).value;

        document.addEventListener("click", async function (e) {

        const btn = e.target.closest(".favorite-btn");

        if (!btn) return;

        e.preventDefault();

        const bookId = btn.dataset.bookId;

        btn.disabled = true;

        try {

        const response = await fetch("/Favorite/ToggleAjax", {

        method: "POST",

        headers: {

        "Content-Type": "application/x-www-form-urlencoded",

        "RequestVerificationToken": token

        },

        body: new URLSearchParams({

        bookId: bookId

        })

        });

        const result = await response.json();

        if (!result.success)
        return;

        const icon = btn.querySelector("i");

        btn.dataset.favorite = result.isFavorite;

        if (result.isFavorite) {

        icon.className =
        "bi bi-heart-fill text-danger";

        }
        else {

        icon.className =
        "bi bi-heart";

        }

        icon.animate([

        {
        transform: "scale(1)"
        },

        {
        transform: "scale(1.35)"
        },

        {
        transform: "scale(1)"
        }

        ], {

        duration: 200

        });

        showFavoriteToast(result.message);

        }
        finally {

        btn.disabled = false;

        }

        });

        });

        function showFavoriteToast(message) {

        const toast =
        document.getElementById("favoriteToast");

        toast.querySelector(".toast-body")
        .innerText = message;

        bootstrap.Toast
        .getOrCreateInstance(toast)
        .show();

        }

    </script>
</body>

</html>
