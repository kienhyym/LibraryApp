@model LibraryApp.ViewModels.Favorite.FavoriteViewModel
@using LibraryApp.ViewModels.Shared

@{
    ViewData["Title"] = "Sách yêu thích";

    var pagination = new PaginationViewModel
    {
        CurrentPage = Model.Books.PageIndex,
        TotalPages = Model.Books.TotalPages,
        Action = "Index"
    };
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold">

                <i class="bi bi-heart-fill text-danger me-2"></i>

                Sách yêu thích

            </h2>

            <p class="text-muted mb-0">

                @* Bạn đã lưu <strong>@Model.Books.TotalCount</strong> cuốn sách yêu thích. *@

            </p>

        </div>

    </div>

    @if (!Model.Books.Any())
    {
        <div class="card border-0 shadow-sm rounded-4">

            <div class="card-body text-center py-5">

                <i class="bi bi-heart display-2 text-muted"></i>

                <h4 class="mt-3">

                    Chưa có sách yêu thích

                </h4>

                <p class="text-muted">

                    Hãy thêm những cuốn sách bạn yêu thích để dễ dàng tìm lại.

                </p>

                <a asp-controller="Books"
                   asp-action="Index"
                   class="btn btn-primary rounded-pill">

                    <i class="bi bi-book me-2"></i>

                    Khám phá sách

                </a>

            </div>

        </div>
    }
    else
    {
        <div class="row row-cols-2 row-cols-md-3 row-cols-lg-5 g-4">

            @foreach (var item in Model.Books)
            {
                <partial name="_BookCard" model="item"/>
            }

        </div>

        <div class="mt-4">

            <partial name="_Pagination"
                     model="pagination"/>

        </div>
    }

</div>