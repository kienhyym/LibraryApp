@model List<LibraryApp.ViewModels.Author.AuthorsViewModel>

@{
    ViewData["Title"] = "Tác giả";
}

<div class="container py-4">

    <div class="mb-5">

        <h2 class="fw-bold mb-2">

            ✍️ Tác giả

        </h2>

        <p class="text-muted mb-0">

            Khám phá các tác giả và những đầu sách trong thư viện.

        </p>

    </div>

    <div class="row g-4">

        @foreach (var item in Model)
        {
            <div class="col-lg-4 col-md-6">

                <div class="card border-0 shadow-sm rounded-4 h-100">

                    <div class="card-body d-flex flex-column">

                        <div class="d-flex align-items-center mb-3">

                            <div class="rounded-circle
                                        bg-primary
                                        bg-opacity-10
                                        d-flex
                                        align-items-center
                                        justify-content-center"
                                 style="width:70px;height:70px;">

                                <i class="bi bi-person-fill
                                          text-primary
                                          fs-2">
                                </i>

                            </div>

                            <div class="ms-3">

                                <h5 class="fw-bold mb-1">

                                    @item.AuthorName

                                </h5>

                                @if (!string.IsNullOrWhiteSpace(item.Nationality))
                                {
                                    <small class="text-muted">

                                        <i class="bi bi-globe"></i>

                                        @item.Nationality

                                    </small>
                                }

                            </div>

                        </div>

                        @if (!string.IsNullOrWhiteSpace(item.Notes))
                        {
                            <p class="text-muted flex-grow-1">

                                @item.Notes

                            </p>
                        }

                        <div class="d-flex
                                    justify-content-between
                                    align-items-center
                                    mt-auto">

                            <span class="badge bg-light text-dark">

                                @item.TotalBooks đầu sách

                            </span>

                            <a asp-controller="Books"
                               asp-action="Index"
                               asp-route-authorId="@item.AuthorId"
                               class="btn btn-outline-primary rounded-pill">

                                Xem sách

                            </a>

                        </div>

                    </div>

                </div>

            </div>
        }

    </div>

</div>