<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Library Admin</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

</head>

<body>
    @{
        var currentArea = ViewContext.RouteData.Values["area"]?.ToString();
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    }
    <div class="admin-wrapper">

        <!-- Sidebar -->
        <aside class="sidebar">

            <div class="logo">

                <i class="bi bi-book-half"></i>

                <span>Library Admin</span>

            </div>

            <ul class="sidebar-menu">

                <li>
                    <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index"
                       class="@(currentController == "Dashboard" ? "active" : "")">

                        <i class="bi bi-speedometer2"></i>

                        Dashboard

                    </a>
                </li>

                <li>
                    <a asp-area="Admin" asp-controller="Book" asp-action="Index"
                       class="@(currentController == "Book" ? "active" : "")">

                        <i class="bi bi-book"></i>

                        Quản lý sách

                    </a>
                </li>

                <li>
                    <a asp-area="Admin" asp-controller="Author" asp-action="Index"
                       class="@(currentController == "Author" ? "active" : "")">

                        <i class="bi bi-person-badge"></i>

                        Tác giả

                    </a>
                </li>
                <li>

                    <a asp-area="Admin" asp-controller="Category" asp-action="Index"
                       class="@(currentController == "Category" ? "active" : "")">

                        <i class="bi bi-tags"></i>

                        Thể loại

                    </a>

                </li>
                <li>
                    <a asp-area="Admin" asp-controller="Resident" asp-action="Index"
                       class="@(currentController == "Resident" ? "active" : "")">

                        <i class="bi bi-people"></i>

                        Cư dân

                    </a>
                </li>

                @if (User.IsInRole("Admin"))
                {
                    <li>
                        <a asp-area="Admin" asp-controller="Personnel" asp-action="Index"
                           class="@(currentController == "Personnel" ? "active" : "")">

                            <i class="bi bi-person-workspace"></i>

                            Nhân viên

                        </a>
                    </li>

                }

                <li>
                    <a asp-area="Admin" asp-controller="Borrow" asp-action="Index"
                       class="@(currentController == "Borrow" ? "active" : "")">

                        <i class="bi bi-journal-text"></i>

                        Phiếu mượn

                    </a>
                </li>

            </ul>

        </aside>

        <!-- Main -->

        <div class="main-content">

            <!-- Topbar -->

            <header class="topbar">

                <h4 class="mb-0">
                    @ViewData["Title"]
                </h4>


                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="dropdown">

                        <button class="btn btn-light dropdown-toggle" type="button" data-bs-toggle="dropdown"
                                aria-expanded="false">

                            <i class="bi bi-person-circle"></i>

                            @User.Identity.Name

                        </button>


                        <ul class="dropdown-menu dropdown-menu-end">

                            <!-- Hồ sơ -->

                            <li class="nav-item">

                                <a asp-area="Admin" asp-controller="Information" asp-action="Index" class="dropdown-item  fw-semibold
                                    @(currentController == "Information" ? "active" : "")">

                                    <i class="bi bi-person-circle me-1"></i>

                                    Hồ sơ

                                </a>

                            </li>


                            <li>
                                <hr class="dropdown-divider">
                            </li>


                            <!-- Đăng xuất -->

                            <li>

                                <a asp-area="" asp-controller="Login" asp-action="Logout" class="dropdown-item text-danger">

                                    <i class="bi bi-box-arrow-right"></i>

                                    Đăng xuất

                                </a>

                            </li>

                        </ul>

                    </div>
                }

            </header>

            <!-- Body -->

            <main class="content">

                @RenderBody()

            </main>

        </div>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="~/js/country-select.js" asp-append-version="true"></script>
    <script src="~/js/select2-helper.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>