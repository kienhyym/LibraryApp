@model LibraryApp.Areas.Admin.ViewModels.Dashboard.BorrowChartViewModel

<div class="card shadow-sm border-0 rounded-4 h-100">

    <div class="card-header bg-white border-0 pt-4 px-4">

        <div class="d-flex justify-content-between align-items-center">

            <div>

                <h5 class="fw-bold mb-1">
                    <i class="bi bi-bar-chart-line me-2"></i>
                    Phiếu mượn theo tháng
                </h5>

                <p id="borrowChartDescription"
                   class="text-muted small mb-0">

                    Số lượng phiếu mượn trong năm @Model.Year

                </p>

            </div>


            <div class="d-flex align-items-center gap-2">

                <span class="text-muted small">
                    Năm
                </span>

                <select id="borrowChartYear"
                        class="form-select form-select-sm"
                        style="width: 100px;">

                    @for (int year = 2026; year <= 2076; year++)
                    {
                        <option value="@year"
                                selected="@(year == Model.Year)">

                            @year

                        </option>
                    }

                </select>

            </div>

        </div>

    </div>


    <div class="card-body px-4 pb-4">

        <div style="height:330px;">

            <canvas id="borrowChart"></canvas>

        </div>

    </div>

</div>