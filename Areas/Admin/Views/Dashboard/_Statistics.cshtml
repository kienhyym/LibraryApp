@model LibraryApp.Areas.Admin.ViewModels.Dashboard.DashboardStatisticViewModel

<div class="card shadow-sm border-0 rounded-4 h-100 dashboard-main-card">

    <div class="card-header bg-white border-0 pt-4 px-4">

        <h5 class="fw-bold mb-1">
            <i class="bi bi-bar-chart-line me-2"></i>
            Tổng quan thư viện
        </h5>

        <p class="text-muted small mb-0">
            Thống kê tổng quan hệ thống
        </p>

    </div>

    <div class="card-body px-4 pb-4">

        <div class="row row-cols-2 row-cols-md-3 g-3">


            <!-- Tổng sách -->

            <div class="col">

                <a asp-area="Admin"
                   asp-controller="Book"
                   asp-action="Index"
                   class="dashboard-stat-card text-decoration-none">

                    <div class="stat-icon bg-primary-subtle text-primary">

                        <i class="bi bi-book"></i>

                    </div>

                    <div class="mt-3">

                        <div class="text-muted small">
                            Tổng đầu sách
                        </div>

                        <div class="fs-3 fw-bold text-dark">
                            @Model.TotalBooks
                        </div>

                    </div>

                </a>

            </div>


            <!-- Tổng tác giả -->

            <div class="col">

                <a asp-area="Admin"
                   asp-controller="Author"
                   asp-action="Index"
                   class="dashboard-stat-card text-decoration-none">

                    <div class="stat-icon bg-success-subtle text-success">

                        <i class="bi bi-person-vcard"></i>

                    </div>

                    <div class="mt-3">

                        <div class="text-muted small">
                            Tổng tác giả
                        </div>

                        <div class="fs-3 fw-bold text-dark">
                            @Model.TotalAuthors
                        </div>

                    </div>

                </a>

            </div>


            <!-- Tổng thể loại -->

            <div class="col">

                <a asp-area="Admin"
                   asp-controller="Category"
                   asp-action="Index"
                   class="dashboard-stat-card text-decoration-none">

                    <div class="stat-icon bg-warning-subtle text-warning">

                        <i class="bi bi-tags"></i>

                    </div>

                    <div class="mt-3">

                        <div class="text-muted small">
                            Tổng thể loại
                        </div>

                        <div class="fs-3 fw-bold text-dark">
                            @Model.TotalCategories
                        </div>

                    </div>

                </a>

            </div>


            <!-- Tổng cư dân -->

            <div class="col">

                <a asp-area="Admin"
                   asp-controller="Resident"
                   asp-action="Index"
                   class="dashboard-stat-card text-decoration-none">

                    <div class="stat-icon bg-info-subtle text-info">

                        <i class="bi bi-people"></i>

                    </div>

                    <div class="mt-3">

                        <div class="text-muted small">
                            Tổng cư dân
                        </div>

                        <div class="fs-3 fw-bold text-dark">
                            @Model.TotalResidents
                        </div>

                    </div>

                </a>

            </div>


            <!-- Tổng phiếu -->

            <div class="col">

                <a asp-area="Admin"
                   asp-controller="Borrow"
                   asp-action="Index"
                   class="dashboard-stat-card text-decoration-none">

                    <div class="stat-icon bg-secondary-subtle text-secondary">

                        <i class="bi bi-journal-text"></i>

                    </div>

                    <div class="mt-3">

                        <div class="text-muted small">
                            Tổng phiếu mượn
                        </div>

                        <div class="fs-3 fw-bold text-dark">
                            @Model.TotalBorrowRecords
                        </div>

                    </div>

                </a>

            </div>


        </div>

    </div>

</div>


<style>

    .dashboard-main-card {
        height: 100%;
    }

    .dashboard-stat-card {

        display: block;

        height: 100%;

        padding: 18px;

        border: 1px solid #eeeeee;

        border-radius: 16px;

        background: #fff;

        transition: all .2s ease;

        cursor: pointer;

    }

    .dashboard-stat-card:hover {

        transform: translateY(-3px);

        box-shadow: 0 .35rem 1rem rgba(0, 0, 0, .08);

        border-color: #dee2e6;

    }

    .dashboard-stat-card:hover .fs-3 {

        text-decoration: underline;

    }

    .stat-icon {

        width: 46px;

        height: 46px;

        border-radius: 12px;

        display: flex;

        align-items: center;

        justify-content: center;

        font-size: 21px;

    }

</style>