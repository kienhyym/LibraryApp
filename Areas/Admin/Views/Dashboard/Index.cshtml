@model LibraryApp.Areas.Admin.ViewModels.Dashboard.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid">

    <!-- Hàng 1 -->

    <div class="row g-4 mb-4 align-items-stretch">

        <div class="col-lg-8 d-flex">

            <partial name="_Statistics" model="Model.Statistics" />

        </div>

        <div class="col-lg-4 d-flex">

            <partial name="_BorrowStatus" model="Model.Statistics" />

        </div>

    </div>


    <!-- Hàng 2 -->

    <div class="row g-4 mb-4">

        <div class="col-lg-6">

            <partial name="_BorrowChart" model="Model.BorrowChart" />

        </div>

        <!-- Top Ranking -->

        <div class="col-lg-6">

            <partial name="_TopRanking" model="Model" />

        </div>

    </div>


    <!-- Hàng 3 -->

    <div class="row">

        <div class="col-12">

            <partial name="_DueBorrow" model="Model.DueBorrows" />

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_BorrowChartScripts" model="Model.BorrowChart" />
}
