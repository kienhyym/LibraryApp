@model List<LibraryApp.Areas.Admin.ViewModels.Dashboard.TopItemViewModel>

@if (Model == null || !Model.Any())
{
    <div class="text-center text-muted py-5">

        <i class="bi bi-bar-chart display-5 d-block mb-3"></i>

        <span>
            Chưa có dữ liệu thống kê.
        </span>

    </div>
}
else
{
    var maxBorrowCount =
        Model.Max(x => x.BorrowCount);

    <div class="dashboard-ranking-list">

        @for (int i = 0; i < Model.Count; i++)
        {
            var item = Model[i];

            var percent = maxBorrowCount > 0
                ? (double)item.BorrowCount / maxBorrowCount * 100
                : 0;

            <div class="ranking-item">

                <div class="d-flex align-items-center">

                    <!-- STT -->

                    <div class="ranking-number">

                        @if (i == 0)
                        {
                            <span class="ranking-medal">
                                🥇
                            </span>
                        }
                        else if (i == 1)
                        {
                            <span class="ranking-medal">
                                🥈
                            </span>
                        }
                        else if (i == 2)
                        {
                            <span class="ranking-medal">
                                🥉
                            </span>
                        }
                        else
                        {
                            <span class="text-muted fw-semibold">
                                @(i + 1)
                            </span>
                        }

                    </div>


                    <!-- Tên -->

                    <div class="flex-grow-1 min-width-0">

                        <div class="d-flex justify-content-between align-items-center mb-1">

                            <div class="fw-semibold text-truncate"
                                 title="@item.Name">

                                @item.Name

                            </div>

                            <span class="text-muted small ms-2 text-nowrap">

                                @item.BorrowCount lượt

                            </span>

                        </div>


                        <!-- Progress -->

                        <div class="progress"
                             style="height: 7px;">

                            <div class="progress-bar"
                                 role="progressbar"
                                 style="width: @percent%;"
                                 aria-valuenow="@item.BorrowCount"
                                 aria-valuemin="0"
                                 aria-valuemax="@maxBorrowCount">
                            </div>

                        </div>

                    </div>

                </div>

            </div>
        }

    </div>
}


<style>

    .dashboard-ranking-list {

        max-height: 360px;

        overflow-y: auto;

        padding-right: 4px;

    }


    .ranking-item {

        padding: 10px 4px;

        border-bottom: 1px solid #f0f0f0;

    }


    .ranking-item:last-child {

        border-bottom: none;

    }


    .ranking-number {

        width: 38px;

        min-width: 38px;

        text-align: center;

    }


    .ranking-medal {

        font-size: 20px;

    }


    .progress {

        background-color: #eef1f4;

        border-radius: 10px;

    }


    .progress-bar {

        border-radius: 10px;

    }


    .dashboard-ranking-list::-webkit-scrollbar {

        width: 5px;

    }


    .dashboard-ranking-list::-webkit-scrollbar-thumb {

        background: #ced4da;

        border-radius: 10px;

    }

</style>