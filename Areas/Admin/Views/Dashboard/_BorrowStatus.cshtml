@model LibraryApp.Areas.Admin.ViewModels.Dashboard.DashboardStatisticViewModel

<div class="card shadow-sm border-0 rounded-4 h-100 dashboard-main-card w-100">

    <div class="card-header bg-white border-0 pt-4 px-4">

        <h5 class="fw-bold mb-1">
            <i class="bi bi-activity me-2"></i>
            Trạng thái mượn
        </h5>

        <p class="text-muted small mb-0">
            Tình trạng các phiếu mượn hiện tại
        </p>

    </div>

    <div class="card-body px-4 pb-4">

        <div class="borrow-status-wrapper">

            <!-- ĐANG MƯỢN -->

            <div class="borrow-status-card borrowing">

                <div class="d-flex align-items-center">

                    <div class="status-icon bg-success-subtle text-success">

                        <i class="bi bi-journal-bookmark-fill"></i>

                    </div>

                    <div class="ms-3">

                        <div class="text-muted small">
                            Phiếu đang mượn
                        </div>

                        <div class="fs-4 fw-bold text-success">
                            @Model.BorrowingRecords
                        </div>

                    </div>

                </div>

                <div class="small text-success mt-2">

                    <i class="bi bi-check-circle me-1"></i>

                    Đang được sử dụng

                </div>

            </div>


            <!-- QUÁ HẠN -->

            <div class="borrow-status-card overdue">

                <div class="d-flex align-items-center">

                    <div class="status-icon bg-danger-subtle text-danger">

                        <i class="bi bi-exclamation-triangle-fill"></i>

                    </div>

                    <div class="ms-3">

                        <div class="text-muted small">
                            Phiếu quá hạn
                        </div>

                        <div class="fs-4 fw-bold text-danger">
                            @Model.OverdueRecords
                        </div>

                    </div>

                </div>

                <div class="small text-danger mt-2">

                    <i class="bi bi-exclamation-circle me-1"></i>

                    Cần được xử lý

                </div>

            </div>

        </div>

    </div>

</div>


<style>

    .dashboard-main-card {
        height: 100%;
    }

    /*
        Hai ô chia đều phần thân card.
    */

    .borrow-status-wrapper {

        height: 100%;

        display: flex;

        flex-direction: column;

        gap: 12px;

    }

    .borrow-status-card {

        flex: 1;

        padding: 14px 16px;

        border-radius: 16px;

        border: 1px solid #eeeeee;

        background: #fff;

        display: flex;

        flex-direction: column;

        justify-content: center;

        transition: all .2s ease;

    }

    .borrow-status-card:hover {

        transform: translateY(-2px);

        box-shadow: 0 .35rem 1rem rgba(0, 0, 0, .08);

    }

    .borrow-status-card.borrowing {

        border-left: 4px solid #198754;

    }

    .borrow-status-card.overdue {

        border-left: 4px solid #dc3545;

    }

    .status-icon {

        width: 40px;

        height: 40px;

        border-radius: 11px;

        display: flex;

        align-items: center;

        justify-content: center;

        font-size: 17px;

        flex-shrink: 0;

    }

</style>