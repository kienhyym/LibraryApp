@using LibraryApp.Areas.Admin.ViewModels.Personnel
@using LibraryApp.Enums

@model PersonnelEditViewModel

@{
    ViewData["Title"] = "Cập nhật nhân viên";
}

<form asp-action="Edit" method="post">

    @Html.AntiForgeryToken()

    <input asp-for="PersonnelId" type="hidden" />

    <input asp-for="AccountId" type="hidden" />

    <div class="row">

        <!-- Thông tin tài khoản -->

        <div class="col-lg-4">

            <div class="card shadow-sm mb-4">

                <div class="card-header bg-primary text-white">

                    <h5 class="mb-0">

                        <i class="bi bi-person-circle"></i>

                        Thông tin tài khoản

                    </h5>

                </div>

                <div class="card-body">

                    <div class="mb-3">

                        <label asp-for="Email" class="form-label"></label>

                        <input asp-for="Email" class="form-control" />

                        <span asp-validation-for="Email" class="text-danger"></span>

                    </div>

                    <div class="mb-3">

                        <label asp-for="IsActive" class="form-label"></label>

                        <select asp-for="IsActive" class="form-select">

                            <option value="true">
                                Hoạt động
                            </option>

                            <option value="false">
                                Khóa tài khoản
                            </option>

                        </select>

                    </div>

                </div>

            </div>

        </div>

        <!-- Thông tin nhân viên -->

        <div class="col-lg-8">

            <div class="card shadow-sm">

                <div class="card-header bg-success text-white">

                    <h5 class="mb-0">

                        <i class="bi bi-person-workspace"></i>

                        Thông tin nhân viên

                    </h5>

                </div>

                <div class="card-body">

                    <div class="row">

                        <div class="col-md-6 mb-3">

                            <label asp-for="FullName" class="form-label"></label>

                            <input asp-for="FullName" class="form-control" />

                            <span asp-validation-for="FullName" class="text-danger"></span>

                        </div>

                        <div class="col-md-6 mb-3">

                            <label asp-for="DateOfBirth" class="form-label"></label>

                            <input asp-for="DateOfBirth" class="form-control" />

                        </div>

                        <div class="col-md-6 mb-3">

                            <label asp-for="Gender" class="form-label"></label>

                            <select asp-for="Gender" asp-items="Html.GetEnumSelectList<Gender>()" class="form-select">

                                <option value="">
                                    -- Chọn giới tính --
                                </option>

                            </select>

                        </div>

                        <div class="col-md-6 mb-3">

                            <label asp-for="PhoneNumber" class="form-label"></label>

                            <input asp-for="PhoneNumber" class="form-control" />

                            <span asp-validation-for="PhoneNumber" class="text-danger"></span>

                        </div>

                        <div class="col-12 mb-3">

                            <label asp-for="PersonnelAddress" class="form-label"></label>

                            <textarea asp-for="PersonnelAddress" rows="3" class="form-control">
    </textarea>

                            <span asp-validation-for="PersonnelAddress" class="text-danger"></span>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <div class="mt-4">

        <button class="btn btn-success">

            <i class="bi bi-check-circle"></i>

            Cập nhật

        </button>

        <a asp-action="Index" class="btn btn-secondary">

            Quay lại

        </a>

    </div>

</form>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}