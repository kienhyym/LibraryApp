@model LibraryApp.Areas.Admin.ViewModels.BookViewModel

@{
    ViewData["Title"] = "Cập nhật sách";
}

<div class="card shadow-sm">

    <div class="card-header bg-white">

        <h4 class="mb-0">

            <i class="bi bi-pencil-square"></i>

            Cập nhật sách

        </h4>

    </div>

    <div class="card-body">

        <form asp-action="Edit"
              method="post"
              enctype="multipart/form-data">

            <input asp-for="BookId" type="hidden" />

            <input asp-for="CoverImage" type="hidden" />

            <div class="row">

                <!-- Left -->

                <div class="col-lg-8">

                    <div class="mb-3">

                        <label asp-for="Title" class="form-label"></label>

                        <input asp-for="Title"
                               class="form-control"
                               placeholder="Nhập tên sách..." />

                        <span asp-validation-for="Title"
                              class="text-danger"></span>

                    </div>

                    <div class="row">

                        <div class="col-md-6">

                            <div class="mb-3">

                                <label asp-for="AuthorId"
                                       class="form-label"></label>

                                <select asp-for="AuthorId"
                                        asp-items="Model.Authors"
                                        id="AuthorId"
                                        class="form-select">

                                    <option value="">
                                        -- Chọn tác giả --
                                    </option>

                                </select>

                                <span asp-validation-for="AuthorId"
                                      class="text-danger"></span>

                            </div>

                        </div>

                        <div class="col-md-6">

                            <div class="mb-3">

                                <label asp-for="CategoryId"
                                       class="form-label"></label>

                                <select asp-for="CategoryId"
                                        asp-items="Model.Categories"
                                        id="CategoryId"
                                        class="form-select">

                                    <option value="">
                                        -- Chọn thể loại --
                                    </option>

                                </select>

                                <span asp-validation-for="CategoryId"
                                      class="text-danger"></span>

                            </div>

                        </div>

                    </div>

                    <div class="row">

                        <div class="col-md-8">

                            <div class="mb-3">

                                <label asp-for="Publisher"
                                       class="form-label"></label>

                                <input asp-for="Publisher"
                                       class="form-control" />

                            </div>

                        </div>

                        <div class="col-md-4">

                            <div class="mb-3">

                                <label asp-for="PublicationYear"
                                       class="form-label"></label>

                                <input asp-for="PublicationYear"
                                       class="form-control" />

                            </div>

                        </div>

                    </div>

                    <div class="mb-3">

                        <label asp-for="Quantity"
                               class="form-label"></label>

                        <input asp-for="Quantity"
                               class="form-control" />

                        <span asp-validation-for="Quantity"
                              class="text-danger"></span>

                    </div>

                    <div class="mb-3">

                        <label asp-for="BookDescription"
                               class="form-label"></label>

                        <textarea asp-for="BookDescription"
                                  rows="5"
                                  class="form-control">
                        </textarea>

                    </div>

                </div>

                <!-- Right -->

                <div class="col-lg-4">

                    <div class="card">

                        <div class="card-body text-center">

                            @if (!string.IsNullOrWhiteSpace(Model.CoverImage))
                            {
                                <img id="previewImage"
                                     src="@Model.CoverImage"
                                     class="img-fluid rounded border mb-3"
                                     style="height:280px;object-fit:contain;" />
                            }
                            else
                            {
                                <img id="previewImage"
                                     src="~/images/no-image.png"
                                     class="img-fluid rounded border mb-3"
                                     style="height:280px;object-fit:contain;" />
                            }

                            <input asp-for="CoverImageFile"
                                   id="CoverImageFile"
                                   type="file"
                                   class="form-control"
                                   accept="image/*" />

                            <div class="text-muted mt-2">

                                Để trống nếu không muốn thay đổi ảnh.

                            </div>

                        </div>

                    </div>

                </div>

            </div>

            <hr />

            <button class="btn btn-success">

                <i class="bi bi-check-circle"></i>

                Cập nhật

            </button>

            <a asp-action="Index"
               class="btn btn-secondary">

                <i class="bi bi-arrow-left"></i>

                Quay lại

            </a>

        </form>

    </div>

</div>

@section Scripts{

<script>

$(function(){

    initSelect2(
        "#AuthorId",
        "Chọn hoặc tìm tác giả");

    initSelect2(
        "#CategoryId",
        "Chọn hoặc tìm thể loại");

    $("#CoverImageFile").change(function(){

        const file=this.files[0];

        if(!file)
            return;

        const reader=new FileReader();

        reader.onload=function(e){

            $("#previewImage")
                .attr("src",e.target.result);

        };

        reader.readAsDataURL(file);

    });

});

</script>

<partial name="_ValidationScriptsPartial"/>

}