@using LibraryApp.Common
@model PaginatedList<LibraryApp.Areas.Admin.ViewModels.BookViewModel>

@{
    ViewData["Title"] = "Quản lý sách";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">

        @TempData["Success"]

        <button class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">

        @TempData["Error"]

        <button class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>
}

<div class="card shadow-sm">

    <div class="card-header bg-white">

        <div class="d-flex justify-content-between align-items-center">

            <h4 class="mb-0">

                <i class="bi bi-book"></i>

                Quản lý sách

            </h4>

            <a asp-action="Create"
               class="btn btn-primary">

                <i class="bi bi-plus-circle"></i>

                Thêm sách

            </a>

        </div>

    </div>

    <div class="card-body">

        <form method="get"
              class="row g-3 mb-4">

            <div class="col-md-4">

                <input
                    type="text"
                    class="form-control"
                    name="keyword"
                    value="@ViewBag.Keyword"
                    placeholder="Tìm theo tên sách..." />

            </div>

            <div class="col-auto">

                <button class="btn btn-primary">

                    <i class="bi bi-search"></i>

                    Tìm

                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">

                    Làm mới

                </a>

            </div>

        </form>

        <div class="table-responsive">

            <table class="table table-hover align-middle">

                <thead class="table-dark">

                    <tr>

                        <th width="90">Ảnh</th>

                        <th>Thông tin sách</th>

                        <th width="140">Kho</th>

                        <th width="120">Trạng thái</th>

                        <th width="120">Thao tác</th>

                    </tr>

                </thead>

                <tbody>

@if (Model.Any())
{
    foreach (var item in Model)
    {
        <tr>

            <td>

@if (string.IsNullOrWhiteSpace(item.CoverImage))
{
    <img src="~/images/no-image.png"
         class="rounded border"
         style="width:70px;height:90px;object-fit:cover;" />
}
else
{
    <img src="@item.CoverImage"
         class="rounded border"
         style="width:70px;height:90px;object-fit:cover;" />
}

            </td>

            <td>

                <div class="fw-bold fs-6">

                    @item.Title

                </div>

                <div class="text-muted">

                    <i class="bi bi-person"></i>

                    @item.AuthorName

                </div>

                <span class="badge bg-secondary mt-1">

                    @item.CategoryName

                </span>

            </td>

            <td>

                <div>

                    Tổng:

                    <strong>

                        @item.Quantity

                    </strong>

                </div>

                <div>

                    Còn:

                    <strong class="text-success">

                        @item.AvailableQuantity

                    </strong>

                </div>

            </td>

            <td>

@if(item.AvailableQuantity > 0)
{
    <span class="badge bg-success">

        Còn sách

    </span>
}
else
{
    <span class="badge bg-danger">

        Hết sách

    </span>
}

            </td>

            <td>

                <a asp-action="Edit"
                   asp-route-id="@item.BookId"
                   class="btn btn-warning btn-sm">

                    <i class="bi bi-pencil-square"></i>

                </a>

                <button
                    class="btn btn-danger btn-sm"
                    onclick="confirmDelete(
                        @item.BookId,
                        '@item.Title')">

                    <i class="bi bi-trash"></i>

                </button>

            </td>

        </tr>
    }
}
else
{
    <tr>

        <td colspan="5"
            class="text-center text-muted">

            Chưa có dữ liệu.

        </td>

    </tr>
}

                </tbody>

            </table>

        </div>

        <div class="d-flex justify-content-between align-items-center">

            <div class="text-muted">

                Tổng cộng

                <strong>

                    @Model.TotalItems

                </strong>

                sách

            </div>

            <nav>

                <ul class="pagination mb-0">

@if(Model.HasPreviousPage)
{
<li class="page-item">

<a class="page-link"
   asp-route-page="@(Model.PageIndex-1)"
   asp-route-keyword="@ViewBag.Keyword">

«

</a>

</li>
}

@for(int i=1;i<=Model.TotalPages;i++)
{
<li class="page-item @(i==Model.PageIndex?"active":"")">

<a class="page-link"
   asp-route-page="@i"
   asp-route-keyword="@ViewBag.Keyword">

@i

</a>

</li>
}

@if(Model.HasNextPage)
{
<li class="page-item">

<a class="page-link"
   asp-route-page="@(Model.PageIndex+1)"
   asp-route-keyword="@ViewBag.Keyword">

»

</a>

</li>
}

                </ul>

            </nav>

        </div>

    </div>

</div>

<div class="modal fade"
     id="deleteModal"
     tabindex="-1">

    <div class="modal-dialog">

        <div class="modal-content">

            <div class="modal-header bg-danger text-white">

                <h5 class="modal-title">

                    Xác nhận xóa

                </h5>

                <button class="btn-close btn-close-white"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <div class="modal-body">

                Bạn có chắc muốn xóa sách

                <strong id="bookName"></strong>

                ?

            </div>

            <div class="modal-footer">

                <button
                    class="btn btn-secondary"
                    data-bs-dismiss="modal">

                    Hủy

                </button>

                <form asp-action="Delete"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input
                        type="hidden"
                        id="deleteId"
                        name="id"/>

                    <button class="btn btn-danger">

                        Xóa

                    </button>

                </form>

            </div>

        </div>

    </div>

</div>

@section Scripts{

<script>

function confirmDelete(id,name){

    document.getElementById("deleteId").value=id;

    document.getElementById("bookName").innerText=name;

    new bootstrap.Modal(
        document.getElementById("deleteModal")
    ).show();

}

</script>

}