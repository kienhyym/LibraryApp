@model LibraryApp.ViewModels.Information.InformationViewModel
@using LibraryApp.Enums

@{
    ViewData["Title"] = "Thông tin cá nhân";
}

<div class="container py-4">
    <div class="row g-4">

        <!-- Left -->

        <div class="col-lg-4">

            <div class="card border-0 shadow rounded-4">

                <div class="card-body text-center p-5">

                    <img src="~/uploads/books/avatar.png" class="rounded-circle shadow-sm mb-4" width="130" height="130"
                         style="object-fit:cover;" />

                    <h3 class="fw-bold">

                        @Model.FullName

                    </h3>


                    <span class="badge bg-primary px-3 py-2">

                        <i class="bi bi-person-badge-fill me-1"></i>

                        Nhân viên thư viện

                    </span>

                    <hr class="my-4" />

                    <div class="d-grid gap-2">

                        <a asp-action="Edit" class="btn btn-primary rounded-pill">

                            <i class="bi bi-pencil-square me-2"></i>

                            Cập nhật thông tin

                        </a>

                        <a asp-area="" asp-controller="Profile" asp-action="ChangePassword"
                           asp-route-returnUrl="/Admin/Information" class="btn btn-outline-primary rounded-pill">

                            <i class="bi bi-key me-2"></i>

                            Đổi mật khẩu

                        </a>

                    </div>

                </div>

            </div>

        </div>

        <!-- Right -->

        <div class="col-lg-8">

            <!-- Personal Information -->

            <div class="card border-0 shadow rounded-4">

                <div class="card-header bg-white border-0 p-4">

                    <h4 class="fw-bold mb-0">

                        Thông tin cá nhân

                    </h4>

                </div>

                <div class="card-body px-4 pb-4">

                    <div class="row gy-4">

                        <!-- Họ tên -->

                        <div class="col-md-6">

                            <small class="text-muted">

                                Họ và tên

                            </small>

                            <div class="fw-semibold fs-5">

                                @Model.FullName

                            </div>

                        </div>

                        <!-- Email -->

                        <div class="col-md-6">

                            <small class="text-muted">

                                Email

                            </small>

                            <div class="fw-semibold fs-5">

                                @Model.Email

                            </div>

                        </div>

                        <!-- Điện thoại -->

                        <div class="col-md-6">

                            <small class="text-muted">

                                Điện thoại

                            </small>

                            <div class="fw-semibold fs-5">

                                @(Model.PhoneNumber
                                    ?? "Chưa cập nhật")

                            </div>

                        </div>

                        <!-- Ngày sinh -->

                        <div class="col-md-6">

                            <small class="text-muted">

                                Ngày sinh

                            </small>

                            <div class="fw-semibold">

                                @(Model.DateOfBirth?.ToString("dd/MM/yyyy")
                                    ?? "Chưa cập nhật")

                            </div>

                        </div>

                        <!-- Giới tính -->

                        <div class="col-md-6">

                            <small class="text-muted">

                                Giới tính

                            </small>

                            <div class="fw-semibold">

                                @if (Model.Gender.HasValue)
                                {
                                    @* @Model.Gender.Value.GetDisplayName() *@
                                }
                                else
                                {
                                    <span class="text-muted">
                                        Chưa cập nhật
                                    </span>
                                }

                            </div>

                        </div>


                        <!-- Ngày tham gia -->

                        <div class="col-md-6">

                            <small class="text-muted">

                                Ngày tham gia

                            </small>

                            <div class="fw-semibold">

                                @Model.CreatedAt.ToString("dd/MM/yyyy")

                            </div>

                        </div>

                        <!-- Địa chỉ -->

                        <div class="col-12">

                            <small class="text-muted">

                                Địa chỉ

                            </small>

                            <div class="fw-semibold">

                                @(Model.PersonnelAddress
                                    ?? "Chưa cập nhật")

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>
</div>