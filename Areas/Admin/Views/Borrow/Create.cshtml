@using LibraryApp.Areas.Admin.ViewModels.Borrow

@model BorrowCreateViewModel

@{
    ViewData["Title"] = "Lập phiếu mượn";
}

<div class="card shadow-sm">

    <div class="card-header bg-white">

        <h4 class="mb-0">

            <i class="bi bi-journal-plus"></i>

            Lập phiếu mượn

        </h4>

    </div>

    <div class="card-body">

        <form asp-action="Create"
              method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <div class="row">

                <div class="col-md-6 mb-3">

                    <label asp-for="ResidentId"
                           class="form-label"></label>

                    <select id="ResidentId"
                            asp-for="ResidentId"
                            class="form-select">

                    </select>

                    <span asp-validation-for="ResidentId"
                          class="text-danger"></span>

                </div>

                <div class="col-md-3 mb-3">

                    <label asp-for="DueDate"
                           class="form-label"></label>

                    <input asp-for="DueDate"
                           class="form-control" />

                    <span asp-validation-for="DueDate"
                          class="text-danger"></span>

                </div>

            </div>

            <div class="mb-3">

                <label asp-for="Notes"
                       class="form-label"></label>

                <textarea asp-for="Notes"
                          class="form-control"
                          rows="3"></textarea>

            </div>

            <hr />

            <div class="row align-items-end">

                <div class="col-md-10">

                    <label class="form-label">

                        Chọn sách

                    </label>

                    <select id="BookSearch"
                            class="form-select">

                    </select>

                </div>

                <div class="col-md-2">

                    <button type="button"
                            id="btnAddBook"
                            class="btn btn-success w-100">

                        <i class="bi bi-plus-circle"></i>

                        Thêm

                    </button>

                </div>

            </div>

            <div class="table-responsive mt-4">

                <table class="table table-bordered align-middle">

                    <thead class="table-light">

                        <tr>

                            <th width="60">

                                STT

                            </th>

                            <th>

                                Tên sách

                            </th>

                            <th width="180">

                                Tác giả

                            </th>

                            <th width="180">

                                Thể loại

                            </th>

                            <th width="90">

                                Xóa

                            </th>

                        </tr>

                    </thead>

                    <tbody id="bookTableBody">

                        <tr>

                            <td colspan="5"
                                class="text-center text-muted">

                                Chưa chọn sách

                            </td>

                        </tr>

                    </tbody>

                </table>

            </div>

            <div id="hiddenBooks"></div>

            <div class="mt-3">

                <button class="btn btn-primary">

                    <i class="bi bi-check-circle"></i>

                    Lưu phiếu mượn

                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">

                    Quay lại

                </a>

            </div>

        </form>

    </div>

</div>

<style>
    .select2-container .select2-selection--single {
        height: 38px;
        padding: 6px 12px;
        border: 1px solid #ced4da;
        border-radius: 0.25rem;
    }
</style>

@section Scripts{

    <partial name="_ValidationScriptsPartial"/>

    <script src="~/js/borrow-create.js"></script>

}

