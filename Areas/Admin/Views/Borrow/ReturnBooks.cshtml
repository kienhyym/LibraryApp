@using LibraryApp.Areas.Admin.ViewModels.Borrow

@model BorrowDetailViewModel

@{
    ViewData["Title"] = "Trả sách";
}

<div class="card shadow-sm">

    <div class="card-header bg-white">

        <h4 class="mb-0">

            <i class="bi bi-arrow-return-left"></i>

            Trả sách

        </h4>

    </div>


    <div class="card-body">

        <form asp-action="ReturnBooks"
              method="post"
              id="returnBookForm">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   name="borrowRecordId"
                   value="@Model.BorrowRecordId" />


            <!-- ===================================== -->
            <!-- THÔNG TIN PHIẾU -->
            <!-- ===================================== -->

            <div class="row">

                <div class="col-md-6 mb-3">

                    <label class="form-label fw-bold">
                        Cư dân
                    </label>

                    <input class="form-control"
                           value="@Model.ResidentName"
                           readonly />

                </div>


                <div class="col-md-3 mb-3">

                    <label class="form-label fw-bold">
                        Ngày mượn
                    </label>

                    <input class="form-control"
                           value="@Model.BorrowDate.ToString("dd/MM/yyyy")"
                           readonly />

                </div>


                <div class="col-md-3 mb-3">

                    <label class="form-label fw-bold">
                        Hạn trả
                    </label>

                    <input class="form-control"
                           value="@Model.DueDate.ToString("dd/MM/yyyy")"
                           readonly />

                </div>

            </div>


            <hr />


            <!-- ===================================== -->
            <!-- DANH SÁCH SÁCH -->
            <!-- ===================================== -->

            <div class="alert alert-info">

                <i class="bi bi-info-circle me-2"></i>

                Vui lòng xử lý tình trạng
                <strong>tất cả sách</strong>
                trong phiếu trước khi xác nhận trả.

            </div>


            <div class="table-responsive">

                <table class="table table-bordered align-middle">

                    <thead class="table-light">

                        <tr>

                            <th style="width: 180px;">
                                Tình trạng
                            </th>

                            <th>
                                Tên sách
                            </th>

                            <th style="width: 220px;">
                                Tác giả
                            </th>

                            <th style="width: 180px;">
                                Thể loại
                            </th>

                            <th style="width: 220px;">
                                Tiền phạt
                            </th>

                            <th style="width: 250px;">
                                Ghi chú
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @for (
                            int i = 0;
                            i < Model.Books.Count;
                            i++)
                        {

                            <tr class="return-book-row">

                                <!-- ================================= -->
                                <!-- Hidden -->
                                <!-- ================================= -->

                                <td>

                                    <input type="hidden"
                                           name="books[@i].BorrowRecordDetailId"
                                           value="@Model.Books[i].BorrowRecordDetailId" />

                                    <input type="hidden"
                                           name="books[@i].BookId"
                                           value="@Model.Books[i].BookId" />


                                    <!-- ================================= -->
                                    <!-- Return Status -->
                                    <!-- ================================= -->

                                    <select name="books[@i].ReturnStatus"
                                            class="form-select return-status">

                                        <option value="1">
                                            Tốt
                                        </option>

                                        <option value="2">
                                            Mất sách
                                        </option>

                                        <option value="3">
                                            Sách hỏng
                                        </option>

                                    </select>

                                </td>


                                <!-- ================================= -->
                                <!-- Book -->
                                <!-- ================================= -->

                                <td>

                                    <div class="fw-semibold">

                                        @Model.Books[i].Title

                                    </div>

                                </td>


                                <!-- ================================= -->
                                <!-- Authors -->
                                <!-- ================================= -->

                                <td>

                                    @Model.Books[i].AuthorName

                                </td>


                                <!-- ================================= -->
                                <!-- Category -->
                                <!-- ================================= -->

                                <td>

                                    @Model.Books[i].CategoryName

                                </td>


                                <!-- ================================= -->
                                <!-- Penalty -->
                                <!-- ================================= -->

                                <td>

                                    <div class="input-group">

                                        <input type="number"
                                               name="books[@i].Penalty"
                                               class="form-control penalty-input"
                                               value="0"
                                               min="0"
                                               max="10000000"
                                               step="1000"
                                               readonly />

                                        <span class="input-group-text">
                                            VNĐ
                                        </span>

                                    </div>


                                    <div class="form-text">

                                        Tối đa:
                                        <strong>
                                            10.000.000 VNĐ
                                        </strong>

                                    </div>

                                </td>


                                <!-- ================================= -->
                                <!-- Note -->
                                <!-- ================================= -->

                                <td>

                                    <input type="text"
                                           class="form-control"
                                           name="books[@i].ReturnNote"
                                           maxlength="500"
                                           placeholder="Ghi chú thêm..." />

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>


            <!-- ===================================== -->
            <!-- TOTAL PENALTY -->
            <!-- ===================================== -->

            <div class="d-flex justify-content-end mt-3">

                <div class="alert alert-warning mb-0">

                    <i class="bi bi-cash-coin me-2"></i>

                    <strong>
                        Tổng tiền phạt:
                    </strong>

                    <span id="totalPenalty"
                          class="fw-bold text-danger">

                        0 VNĐ

                    </span>

                </div>

            </div>


            <!-- ===================================== -->
            <!-- BUTTON -->
            <!-- ===================================== -->

            <div class="mt-4">

                <button id="btnReturn"
                        type="submit"
                        class="btn btn-success">

                    <i class="bi bi-check-circle me-1"></i>

                    Xác nhận trả toàn bộ sách

                </button>


                <a asp-action="Detail"
                   asp-route-id="@Model.BorrowRecordId"
                   class="btn btn-secondary">

                    <i class="bi bi-arrow-left me-1"></i>

                    Quay lại

                </a>

            </div>

        </form>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />


    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                const form =
                    document.getElementById(
                        "returnBookForm");

                const rows =
                    document.querySelectorAll(
                        ".return-book-row");

                const totalPenalty =
                    document.getElementById(
                        "totalPenalty");


                // =====================================
                // CONSTANT
                // =====================================

                const MAX_PENALTY = 10000000;


                // =====================================
                // Tính tổng tiền phạt
                // =====================================

                function calculateTotalPenalty() {

                    let total = 0;

                    document
                        .querySelectorAll(
                            ".penalty-input")
                        .forEach(function (input) {

                            let value =
                                parseFloat(
                                    input.value) || 0;

                            if (value < 0) {
                                value = 0;
                            }

                            if (value > MAX_PENALTY) {
                                value = MAX_PENALTY;
                            }

                            total += value;

                        });


                    totalPenalty.textContent =
                        total.toLocaleString("vi-VN")
                        + " VNĐ";
                }


                // =====================================
                // Xử lý từng sách
                // =====================================

                rows.forEach(function (row) {

                    const status =
                        row.querySelector(
                            ".return-status");

                    const penalty =
                        row.querySelector(
                            ".penalty-input");


                    function updatePenalty() {

                        // =================================
                        // Tốt
                        // =================================

                        if (status.value === "1") {

                            penalty.value = "0";

                            penalty.readOnly = true;

                        }

                        // =================================
                        // Mất / Hỏng
                        // =================================

                        else {

                            penalty.readOnly = false;

                        }


                        calculateTotalPenalty();

                    }


                    // Status change

                    status.addEventListener(
                        "change",
                        updatePenalty);


                    // Penalty input

                    penalty.addEventListener(
                        "input",
                        function () {

                            let value =
                                parseFloat(
                                    penalty.value) || 0;


                            if (value < 0) {

                                penalty.value = "0";

                            }


                            if (value > MAX_PENALTY) {

                                penalty.value =
                                    MAX_PENALTY;

                            }


                            calculateTotalPenalty();

                        });


                    updatePenalty();

                });


                // =====================================
                // Submit
                // =====================================

                form.addEventListener(
                    "submit",
                    function (e) {

                        e.preventDefault();


                        // =================================
                        // Kiểm tra penalty
                        // =================================

                        let invalidPenalty = false;


                        document
                            .querySelectorAll(
                                ".penalty-input")
                            .forEach(function (input) {

                                const value =
                                    parseFloat(
                                        input.value) || 0;


                                if (
                                    value < 0 ||
                                    value > MAX_PENALTY
                                ) {

                                    invalidPenalty =
                                        true;

                                }

                            });


                        if (invalidPenalty) {

                            Swal.fire({

                                icon: "warning",

                                title: "Tiền phạt không hợp lệ",

                                text:
                                    "Tiền phạt phải từ 0 đến 10.000.000 VNĐ.",

                                confirmButtonText:
                                    "Đã hiểu"

                            });

                            return;
                        }


                        // =================================
                        // Confirm
                        // =================================

                        Swal.fire({

                            title:
                                "Xác nhận trả toàn bộ sách?",

                            text:
                                "Sau khi xác nhận, toàn bộ thông tin trả sách sẽ được lưu và phiếu mượn sẽ hoàn tất.",

                            icon:
                                "question",

                            showCancelButton:
                                true,

                            confirmButtonText:
                                "Xác nhận trả sách",

                            cancelButtonText:
                                "Hủy",

                            reverseButtons:
                                true

                        }).then(function (result) {

                            if (result.isConfirmed) {

                                form.submit();

                            }

                        });

                    });

            });

    </script>
}